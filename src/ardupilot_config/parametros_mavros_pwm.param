# --- RED ETHERNET HACIA LA PC A BORDO ---
NET_ENABLE, 1
NET_IP_ADDR, 192.168.0.100
NET_NETMASK, 255.255.255.0

# --- COMUNICACIÓN MAVLINK POR RED ---
# Configura el puerto de red virtual (SERIAL20) para usar MAVLink 2
SERIAL20_PROTOCOL, 2

# --- PROPULSORES T200 (PASSTHRU PARA MAVROS) ---
SERVO1_FUNCTION, 51
SERVO3_FUNCTION, 53

# --- LÍMITES PWM (BLUE ROBOTICS T200) ---
SERVO1_MIN, 1100
SERVO1_TRIM, 1500
SERVO1_MAX, 1900
SERVO3_MIN, 1100
SERVO3_TRIM, 1500
SERVO3_MAX, 1900