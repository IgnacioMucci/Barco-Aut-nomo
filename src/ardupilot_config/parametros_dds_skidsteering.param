#Config para NodoCmdVel y para NodoGpsWaypoint

# --- RED ETHERNET HACIA LA PC A BORDO ---
NET_ENABLE, 1
NET_IP_ADDR, 192.168.0.100
NET_NETMASK, 255.255.255.0

# --- HABILITAR DDS/ROS 2 ---
DDS_ENABLE, 1

# --- PROPULSORES T200 (SKID STEERING) ---
# 73 = Throttle Left, 74 = Throttle Right
SERVO1_FUNCTION, 73
SERVO3_FUNCTION, 74

# --- LÍMITES PWM (BLUE ROBOTICS T200) ---
SERVO1_MIN, 1100
SERVO1_TRIM, 1500
SERVO1_MAX, 1900
SERVO3_MIN, 1100
SERVO3_TRIM, 1500
SERVO3_MAX, 1900